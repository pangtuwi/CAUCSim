# CAUCSim Admin — local overrides
#
# The shared AWS values live in the repo-root .env and are reused as-is:
#   S3_BUCKET_NAME, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
#   COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID
#
# This file is only for admin-specific settings. Anything set here wins over
# the root .env (lib/config.js loads this file first — see the comment there).

# Port to listen on. 3000 belongs to the CFD dev server, so the admin app uses 3001.
ADMIN_PORT=3001

# Cognito group whose members are allowed in. Create it with:
#   aws cognito-idp create-group --region eu-west-2 \
#     --user-pool-id eu-west-2_ft1OVuuU1 --group-name admins
# Members must sign out and back in before the claim appears in their token.
ADMIN_GROUP=admins

# How many job.json objects to fetch from S3 in parallel.
ADMIN_S3_CONCURRENCY=8

# How long a scan of the results/ prefix is reused before being refetched (ms).
ADMIN_JOB_CACHE_TTL_MS=30000

# When true, destructive actions also write an audit object to admin-audit/ in
# the bucket. They are always written to stdout/CloudWatch regardless.
ADMIN_AUDIT_S3=false
