{
  "scripts": {
    "start": "node backend/app/app.js",
    "dev": "node --watch backend/app/app.js",
    "test": "jest",
    "admin": "npm start --prefix admin",
    "admin:test": "npm test --prefix admin",
    "upload-template": "node scripts/upload-template.js"
  },
  "jest": {
    "//": "admin/ is a separate app with its own package.json and node_modules. Its tests resolve the AWS SDK from admin/node_modules, so they must run under admin's own jest (npm run admin:test), not this one.",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/admin/"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "supertest": "^7.2.2",
    "three": "^0.185.1"
  }
}
