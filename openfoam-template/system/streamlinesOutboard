type            streamlines;
libs            ("libfieldFunctionObjects.so");

// Output every
writeControl    writeTime;

// Write format
setFormat       vtk;

// Track forward (+U) or backward (-U) or both
direction       forward;

// Names of fields to sample. Should contain above velocity field!
fields          (p U k);

// Steps particles can travel before being removed
lifeTime        10000;

// Number of steps per cell (estimate). Set to 1 to disable subcycling.
nSubCycle       5;

// Cloud name to use
cloudName       particleTracks;

// Seeding method. This is the "outboard" set, tuned to sit 0.3m to one
// side of the centreline (same side as the "current" set at -0.1m), 1m
// upstream of the nose so it lands in car-disturbed flow downstream
// rather than missing the car entirely further outboard.
seedSampleSet
{
    type        lineUniform;
    start       (-1.001 -0.3 0.0011);
    end         (-1.001 -0.3 1.0011);
    nPoints     20;
}


