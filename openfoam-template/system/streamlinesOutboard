type            streamlines;
libs            ("libfieldFunctionObjects.so");

// Output every
writeControl    writeTime;

// Write format
setFormat       vtk;

// Track forward (+U) or backward (-U) or both
direction       forward;

// Names of fields to sample. Should contain above velocity field!
fields          (p U k);

// Steps particles can travel before being removed
lifeTime        10000;

// Number of steps per cell (estimate). Set to 1 to disable subcycling.
nSubCycle       5;

// Cloud name to use
cloudName       particleTracks;

// Seeding method. This is the "outboard" set. Y=-0.4 is a tuned starting
// point, not a measured value: the seed line sits 1m upstream of the nose,
// so it needs to land where it will actually pass through car-disturbed
// flow downstream. For a typical FSAE half-track of ~0.6-0.65m to the tyre
// centreline, -0.4 targets the sidepod/front-wheel transition zone (likely
// to show wheel-wake/outwash interaction) rather than missing the car
// entirely further outboard. Adjust once verified against a real car STL.
seedSampleSet
{
    type        lineUniform;
    start       (-1.001 -0.4 0.0011);
    end         (-1.001 -0.4 1.0011);
    nPoints     20;
}


