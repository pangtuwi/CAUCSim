# S3 Bucket Configuration (Strictly required. There is no local-disk mock fallback mode)
S3_BUCKET_NAME=
AWS_REGION=eu-west-2

# AWS Credentials (Strictly required for local development to interact with S3. DO NOT deploy these to AWS Lambda!)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DigitalOcean Configuration
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_PROJECT_ID=efc7b19b-24a6-4149-bc96-4e90a71cdbd1
DIGITALOCEAN_SSH_KEY_FP=
# Required. Must name a snapshot with ParaView + Xvfb installed, or jobs will
# complete without the 3D streamlines artifacts (see Documentation/SETUP_DROPLET.md).
DIGITALOCEAN_SNAPSHOT_NAME=openfoam-base_V2
DIGITALOCEAN_REGION=lon1
DIGITALOCEAN_SIZE=gd-16vcpu-64gb

# Application Callback Endpoint Resolution (Required in production)
APP_CALLBACK_URL=

