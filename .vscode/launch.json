{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run CAUCSim Server",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/backend/app/app.js",
      "runtimeArgs": [
        "--watch"
      ],
      "console": "integratedTerminal",
      "restart": false
    }
  ]
}
